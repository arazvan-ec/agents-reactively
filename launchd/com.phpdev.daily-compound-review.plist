<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Daily Compound Review - launchd configuration

    Este job revisa los threads de las últimas 24 horas y extrae aprendizajes.
    Se ejecuta a las 22:30 (antes de auto-compound).

    Instalación:
    1. Copiar a ~/Library/LaunchAgents/
    2. Actualizar las rutas según tu configuración
    3. launchctl load ~/Library/LaunchAgents/com.phpdev.daily-compound-review.plist

    Verificar:
    launchctl list | grep phpdev
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.phpdev.daily-compound-review</string>

    <key>ProgramArguments</key>
    <array>
        <!-- ACTUALIZAR: Ruta al script -->
        <string>/Users/YOUR_USERNAME/projects/php-project/scripts/daily-compound-review.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <!-- ACTUALIZAR: Ruta al proyecto -->
    <string>/Users/YOUR_USERNAME/projects/php-project</string>

    <!-- Ejecutar a las 22:30 todos los días -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <!-- ACTUALIZAR: Ruta de logs -->
    <string>/Users/YOUR_USERNAME/projects/php-project/logs/compound-review.log</string>

    <key>StandardErrorPath</key>
    <!-- ACTUALIZAR: Ruta de logs -->
    <string>/Users/YOUR_USERNAME/projects/php-project/logs/compound-review.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <!-- ACTUALIZAR: Tu directorio home -->
        <string>/Users/YOUR_USERNAME</string>
    </dict>

    <!-- No reintentar si falla -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Evitar múltiples instancias -->
    <key>AbandonProcessGroup</key>
    <false/>
</dict>
</plist>
